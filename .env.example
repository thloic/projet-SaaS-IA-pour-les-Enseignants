NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_QUALITY_MODEL=claude-sonnet-4-5
# 32 octets encodés en base64 (ex. `openssl rand -base64 32`). Requis pour
# chiffrer les clés Anthropic personnelles enregistrées par les utilisateurs.
AI_CREDENTIALS_ENCRYPTION_KEY=
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
AUDIO_TRANSCRIPTION_MODE=real
AUDIO_TRANSCRIPTION_LIMIT=30
PRO_AUDIO_TRANSCRIPTION_LIMIT=300
# Connexion Gmail/Drive de l'enseignant (OAuth dédié, distinct du SSO de
# connexion) — voir docs/PRD-agent-envoi-gmail-drive.md. Mode Test Google
# (jusqu'à 100 comptes testeurs) : aucune vérification requise pour essayer.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_INTEGRATIONS_MODE=real
EMAIL_SEND_LIMIT=10
PRO_EMAIL_SEND_LIMIT=200
PAT_GENERATION_MODE=real
AGENT_GENERATION_LIMIT=3
PRO_GENERATION_LIMIT=90
AGENT_PRO_GENERATION_LIMIT=150
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=
# Un Coupon Stripe par palier (percent_off fixe, duration: forever), créé au
# Dashboard — programme ambassadeur, voir docs/PLAN-ambassadeurs.md Phase 3.
STRIPE_COUPON_ID_AMBASSADOR_10=
STRIPE_COUPON_ID_AMBASSADOR_20=
STRIPE_COUPON_ID_AMBASSADOR_30=
STRIPE_COUPON_ID_AMBASSADOR_40=
STRIPE_COUPON_ID_AMBASSADOR_50=
STRIPE_COUPON_ID_AMBASSADOR_60=
STRIPE_COUPON_ID_AMBASSADOR_70=
STRIPE_COUPON_ID_AMBASSADOR_80=
STRIPE_COUPON_ID_AMBASSADOR_90=
STRIPE_COUPON_ID_AMBASSADOR_100=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_APP_URL=
# Sentry (suivi d'erreurs) — DSN à créer sur sentry.io, laisser vide désactive le SDK sans erreur.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optionnels : uniquement pour l'upload des source maps au build (dashboard Sentry > Settings > Auth Tokens).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
